#!/usr/bin/env python3
import argparse, base64, binascii, itertools, json, re, string, sys
from pathlib import Path

PRINTABLE=set(bytes(string.printable,'ascii'))
CHARSETS={
 'printable': bytes(string.printable[:-6],'ascii'), 'digits':bytes(string.digits,'ascii'),
 'lowercase':bytes(string.ascii_lowercase,'ascii'),'uppercase':bytes(string.ascii_uppercase,'ascii'),
 'alnum':bytes(string.ascii_letters+string.digits,'ascii'),'hex':bytes(string.hexdigits,'ascii'),
 'all-bytes':bytes(range(256))}

def _clean(s):
 s=s.strip().strip('"\''); return ''.join(s.split())
def detect_base64_variant(s):
 s=_clean(s)
 if '-' in s or '_' in s: return 'base64url'
 if '+' in s or '/' in s: return 'base64'
 return 'ambiguous/base64-compatible'
def normalize_base64(s):
 s=_clean(s)
 if not s: raise ValueError('empty input')
 if re.search(r'[^A-Za-z0-9+/=_-]',s): raise ValueError('invalid Base64 character present')
 if '=' in s[:-2]: raise ValueError('padding appears before the end')
 return s + '='*((-len(s))%4)
def decode_base64(s, urlsafe=None):
 n=normalize_base64(s); detected=detect_base64_variant(s)
 if urlsafe is None: urlsafe=detected=='base64url'
 try:
  if urlsafe: return base64.b64decode(n,altchars=b'-_',validate=True)
  return base64.b64decode(n,validate=True)
 except (binascii.Error,ValueError) as e: raise ValueError(f'Base64 decode failed: {e}')
def encode_base64(data, urlsafe=False, padded=True):
 out=(base64.urlsafe_b64encode(data) if urlsafe else base64.b64encode(data)).decode()
 return out if padded else out.rstrip('=')
def escaped(data): return ''.join(chr(b) if 32<=b<127 else f'\\x{b:02x}' for b in data)
def printable_ratio(data): return 100.0 if not data else sum(32<=b<127 or b in (9,10,13) for b in data)*100/len(data)
def hexdump(data,width=16):
 rows=['OFFSET    HEX BYTES                                         ASCII']
 for off in range(0,len(data),width):
  c=data[off:off+width]; hx=' '.join(f'{b:02x}' for b in c); asc=''.join(chr(b) if 32<=b<127 else '.' for b in c)
  rows.append(f'{off:08x}  {hx:<47}  {asc}')
 return '\n'.join(rows)
def extract_strings(data,min_length=4):
 pat=rb'[\x20-\x7e]{'+str(min_length).encode()+rb',}'; return [m.decode('ascii') for m in re.findall(pat,data)]
def inspect_bytes(data):
 try: txt=data.decode('utf-8'); valid=True
 except UnicodeDecodeError: txt=None; valid=False
 return {'length':len(data),'utf8_valid':valid,'utf8':txt,'hex':data.hex(),'escaped':escaped(data),'printable_ratio':printable_ratio(data)}
def looks_like_base64(data):
 try:s=data.decode('ascii').strip()
 except UnicodeDecodeError:return False
 if len(s)<4 or len(_clean(s))%4==1:return False
 if not re.fullmatch(r'[A-Za-z0-9+/=_\-\s]+',s):return False
 try: decode_base64(s); return True
 except ValueError:return False
def recursive_decode(s,max_depth=5):
 out=[]; cur=s
 for depth in range(1,max_depth+1):
  raw=decode_base64(cur); out.append(raw)
  if not looks_like_base64(raw): break
  nxt=raw.decode('ascii').strip()
  if nxt==cur: break
  cur=nxt
 return out
def inspect_jwt(token):
 p=token.strip().split('.')
 if len(p)!=3: raise ValueError('JWT must contain exactly three segments')
 def dec_json(x):
  raw=decode_base64(x,True)
  try:return json.loads(raw.decode()),raw
  except Exception:return None,raw
 h,hr=dec_json(p[0]); pl,pr=dec_json(p[1]); sig=decode_base64(p[2],True) if p[2] else b''
 return {'header':h,'header_raw':hr,'payload':pl,'payload_raw':pr,'signature_b64url':p[2],'signature_hex':sig.hex(),'signature_length':len(sig)}
def repeating_xor(data,key):
 if not key: raise ValueError('key must not be empty')
 return bytes(b^key[i%len(key)] for i,b in enumerate(data))
def score_plaintext(data):
 if not data:return -1e9
 pr=printable_ratio(data); score=pr*1.8
 ctrl=sum(b<32 and b not in (9,10,13) for b in data); score-=ctrl*8
 try:t=data.decode('utf-8'); score+=15
 except UnicodeDecodeError:t=data.decode('latin1'); score-=15
 low=t.lower(); score+=low.count(' ')*1.2
 score+=sum(low.count(w)*6 for w in (' the ',' and ',' to ',' of ',' is ','http','thm{','flag','password','secret','meeting'))
 score+=sum(c in string.ascii_letters for c in t)*0.12
 return score
def single_byte_xor_candidates(data,top=10):
 vals=[]
 for k in range(256):
  pt=bytes(b^k for b in data); vals.append((score_plaintext(pt),bytes([k]),pt))
 return sorted(vals,reverse=True,key=lambda x:x[0])[:top]
def _charset(name):
 if name not in CHARSETS: raise ValueError('unknown charset: '+name)
 return CHARSETS[name]
def wildcard_search_space(pattern,charset='printable'):
 return len(_charset(charset))**pattern.count('?')
def expand_key_pattern(pattern,charset='printable',max_space=1_000_000):
 slots=pattern.count('?'); chars=_charset(charset); space=len(chars)**slots
 if space>max_space: raise ValueError(f'key search space {space:,} exceeds limit {max_space:,}')
 if slots==0: yield pattern.encode(); return
 for combo in itertools.product(chars,repeat=slots):
  it=iter(combo); yield bytes(next(it) if ch=='?' else ord(ch) for ch in pattern)
def wildcard_xor_candidates(ciphertexts,pattern,charset='printable',top=10,max_space=1_000_000):
 best=[]
 for key in expand_key_pattern(pattern,charset,max_space):
  pts=[repeating_xor(c,key) for c in ciphertexts]; sc=sum(score_plaintext(p) for p in pts)/len(pts)
  best.append((sc,key,pts))
 return sorted(best,reverse=True,key=lambda x:x[0])[:top]
def encode_other_base(data,kind):
 f={'base16':base64.b16encode,'base32':base64.b32encode,'base64':base64.b64encode,'base85':base64.b85encode,'ascii85':base64.a85encode}.get(kind)
 if kind=='base32hex' and hasattr(base64,'b32hexencode'): f=base64.b32hexencode
 if not f: raise ValueError('unsupported encoding')
 return f(data).decode()
def decode_other_base(text,kind):
 s=_clean(text).encode(); f={'base16':base64.b16decode,'base32':base64.b32decode,'base64':base64.b64decode,'base85':base64.b85decode,'ascii85':base64.a85decode}.get(kind)
 if kind=='base32hex' and hasattr(base64,'b32hexdecode'): f=base64.b32hexdecode
 if not f: raise ValueError('unsupported encoding')
 try:return f(s)
 except Exception as e: raise ValueError(f'{kind} decode failed: {e}')
def show_inspection(raw,show_hex=False,show_strings=False,min_string=4):
 i=inspect_bytes(raw); print(f"Decoded bytes : {i['length']}"); print(f"UTF-8 valid   : {'yes' if i['utf8_valid'] else 'no'}"); print(f"Printable     : {i['printable_ratio']:.1f}%")
 if i['utf8_valid']: print('Text          :',i['utf8'])
 else: print('Escaped       :',i['escaped']); print('Hex           :',i['hex'])
 if show_hex: print('\n'+hexdump(raw))
 if show_strings:
  ss=extract_strings(raw,min_string); print('\nStrings:'); print('\n'.join(ss) if ss else '(none)')
def print_candidates(cands):
 for n,(sc,key,pts) in enumerate(cands,1):
  print(f'\nCandidate #{n}\nKey: {escaped(key)}\nKey hex: {key.hex()}\nScore: {sc:.2f}')
  for j,p in enumerate(pts,1): print(f'[{j}] {escaped(p[:500])}')
def write_output(path,data,force=False):
 p=Path(path)
 if p.exists() and not force: raise ValueError(f'{path} exists; use --force to overwrite')
 p.write_bytes(data)
def info():
 print('Standard Base64: A-Z a-z 0-9 + /\nBase64URL:       A-Z a-z 0-9 - _\n= is padding. Base64URL avoids URL-reserved + and /.\nBase64 is encoding, not encryption.')
def interactive():
 print('=== BASE64 PEEK ===\n[1] Decode / inspect Base64\n[2] Encode text\n[3] XOR analysis\n[4] JWT inspector\n[5] Other base encodings\n[6] Base64 info\n[0] Exit')
 c=input('\nChoice [1]: ').strip() or '1'
 if c=='0':return
 if c=='1':
  v=input('Paste Base64/Base64URL value: ').strip(); raw=decode_base64(v); print('Detected      :',detect_base64_variant(v)); show_inspection(raw,True,True)
  if looks_like_base64(raw) and input('Decoded data resembles Base64. Decode another layer? [y/N]: ').lower()=='y':
   for n,x in enumerate(recursive_decode(v),1): print(f'\nLayer {n}:'); show_inspection(x)
 elif c=='2': print(encode_base64(input('Text: ').encode(),input('URL-safe? [y/N]: ').lower()=='y'))
 elif c=='3':
  v=input('Paste Base64 ciphertext: '); data=decode_base64(v); mode=input('[1] Single-byte XOR [2] Known repeating key [3] Wildcard key: ').strip()
  if mode=='1': print_candidates([(s,k,[p]) for s,k,p in single_byte_xor_candidates(data)])
  elif mode=='2': show_inspection(repeating_xor(data,input('Key: ').encode()))
  elif mode=='3':
   pat=input('Key pattern (? = unknown): '); cs=input('Charset [printable]: ').strip() or 'printable'; print_candidates(wildcard_xor_candidates([data],pat,cs))
 elif c=='4': print(json.dumps(inspect_jwt(input('JWT: ')),indent=2,default=lambda x:x.decode(errors='replace') if isinstance(x,bytes) else str(x)))
 elif c=='5':
  kind=input('Encoding [base16/base32/base32hex/base64/base85/ascii85]: ').strip(); op=input('[e]ncode/[d]ecode: ').lower(); val=input('Value: '); print(encode_other_base(val.encode(),kind) if op.startswith('e') else escaped(decode_other_base(val,kind)))
 elif c=='6': info()
def parser():
 p=argparse.ArgumentParser(description='Offline Base64/base-encoding inspector and XOR analysis helper')
 g=p.add_mutually_exclusive_group()
 for a in ('decode','decode-url','encode','encode-url','jwt','hexdump','strings','xor-single','xor-pattern','xor-key'): g.add_argument('--'+a)
 g.add_argument('--decode-file'); g.add_argument('--encode-file'); p.add_argument('--output'); p.add_argument('--force',action='store_true'); p.add_argument('--unpadded',action='store_true'); p.add_argument('--recursive',action='store_true'); p.add_argument('--max-depth',type=int,default=5); p.add_argument('--min-string',type=int,default=4); p.add_argument('--key'); p.add_argument('--key-pattern'); p.add_argument('--charset',choices=CHARSETS,default='printable'); p.add_argument('--top',type=int,default=10); p.add_argument('--max-search-space',type=int,default=1_000_000); p.add_argument('--xor-extra',action='append',default=[],help='additional Base64 ciphertext using same wildcard key'); p.add_argument('--other-encode',choices=['base16','base32','base32hex','base64','base85','ascii85']); p.add_argument('--other-decode',choices=['base16','base32','base32hex','base64','base85','ascii85']); p.add_argument('--value'); p.add_argument('--info',action='store_true'); return p
def main(argv=None):
 a=parser().parse_args(argv)
 try:
  if len(sys.argv)==1 and argv is None: interactive(); return 0
  if a.info: info(); return 0
  if a.encode is not None or a.encode_url is not None:
   v=a.encode if a.encode is not None else a.encode_url; print(encode_base64(v.encode(),a.encode_url is not None,not a.unpadded)); return 0
  if a.encode_file:
   out=encode_base64(Path(a.encode_file).read_bytes(),False,not a.unpadded); print(out); return 0
  if a.jwt: print(json.dumps(inspect_jwt(a.jwt),indent=2,default=lambda x:x.decode(errors='replace') if isinstance(x,bytes) else str(x))); return 0
  if a.other_encode or a.other_decode:
   if a.value is None: raise ValueError('--value is required')
   print(encode_other_base(a.value.encode(),a.other_encode) if a.other_encode else escaped(decode_other_base(a.value,a.other_decode))); return 0
  val=None; url=None
  if a.decode is not None: val=a.decode
  elif a.decode_url is not None: val=a.decode_url; url=True
  elif a.decode_file: val=Path(a.decode_file).read_text()
  elif a.hexdump is not None: val=a.hexdump
  elif a.strings is not None: val=a.strings
  elif a.xor_single is not None: val=a.xor_single
  elif a.xor_pattern is not None: val=a.xor_pattern
  elif a.xor_key is not None: val=a.xor_key
  if val is None: parser().print_help(); return 0
  raw=decode_base64(val,url)
  if a.output: write_output(a.output,raw,a.force); print(f'Wrote {len(raw)} bytes to {a.output}'); return 0
  if a.hexdump is not None: print(hexdump(raw)); return 0
  if a.strings is not None: print('\n'.join(extract_strings(raw,a.min_string))); return 0
  if a.xor_single is not None: print_candidates([(s,k,[p]) for s,k,p in single_byte_xor_candidates(raw,a.top)]); return 0
  if a.xor_key is not None:
   if not a.key: raise ValueError('--key is required')
   show_inspection(repeating_xor(raw,a.key.encode())); return 0
  if a.xor_pattern is not None:
   pat=a.key_pattern
   if not pat: raise ValueError('--key-pattern is required')
   cts=[raw]+[decode_base64(x) for x in a.xor_extra]; print_candidates(wildcard_xor_candidates(cts,pat,a.charset,a.top,a.max_search_space)); return 0
  print('Detected      :',detect_base64_variant(val)); show_inspection(raw)
  if a.recursive:
   for n,x in enumerate(recursive_decode(val,a.max_depth),1): print(f'\nLayer {n}:\n{escaped(x)}')
  return 0
 except (ValueError,OSError) as e: print('Error:',e,file=sys.stderr); return 2
if __name__=='__main__': raise SystemExit(main())
